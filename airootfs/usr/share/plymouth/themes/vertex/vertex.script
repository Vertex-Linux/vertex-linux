// Vertex Linux Plymouth — logo only, centered
Window.SetBackgroundTopColor(0.102, 0.043, 0.180);
Window.SetBackgroundBottomColor(0.039, 0.012, 0.067);

logo = Image("logo.png");
logo_sprite = Sprite(logo);
logo_sprite.SetX(Window.GetWidth()  / 2 - logo.GetWidth()  / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - logo.GetHeight() / 2);
logo_sprite.SetZ(10);
