#!/usr/bin/env bash
# Vertex Linux — flatpak shim: warns users to use vpkg, but still runs.

if [[ "${_VPKG_INTERNAL:-0}" != "1" ]]; then
    cat >&2 << 'EOF'

  ┌──────────────────────────────────────────────────────┐
  │  Tip: On Vertex Linux, use vpkg instead of flatpak.  │
  │    vpkg fp install  <app-id>                         │
  │    vpkg fp remove   <app-id>                         │
  │    vpkg fp update                                    │
  └──────────────────────────────────────────────────────┘

EOF
fi

exec /usr/bin/flatpak "$@"
