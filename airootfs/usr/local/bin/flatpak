#!/usr/bin/env bash
# Vertex Linux — flatpak shim
# Passes through when called by vpkg or calamares; otherwise redirects to vpkg.

_called_by_calamares() {
    local pid=$PPID
    while [[ "$pid" -gt 1 ]]; do
        local comm
        comm=$(cat /proc/$pid/comm 2>/dev/null) || break
        [[ "$comm" == "calamares" ]] && return 0
        pid=$(awk '/^PPid:/{print $2}' /proc/$pid/status 2>/dev/null) || break
    done
    return 1
}

if [[ "${_VPKG_INTERNAL:-0}" == "1" ]] || _called_by_calamares; then
    exec /usr/bin/flatpak "$@"
fi

cat >&2 << 'EOF'

  ┌──────────────────────────────────────────────────────┐
  │  Direct flatpak access is disabled on Vertex Linux.  │
  │                                                      │
  │  Use vpkg instead:                                   │
  │    vpkg fp install  <app-id>                         │
  │    vpkg fp remove   <app-id>                         │
  │    vpkg fp search   <query>                          │
  │    vpkg fp update                                    │
  │    vpkg fp list                                      │
  └──────────────────────────────────────────────────────┘

EOF
exit 1
