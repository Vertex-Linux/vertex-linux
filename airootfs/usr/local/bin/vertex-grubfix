#!/usr/bin/env bash
# Write grub.cfg directly from the fstab UUID.
# grub-mkconfig fails to detect the kernel inside the Calamares chroot,
# so we generate the file ourselves after the bootloader module runs.

ROOT_UUID=$(awk '$2 == "/" && $1 ~ /^UUID=/ { gsub(/^UUID=/, "", $1); print $1; exit }' /etc/fstab)

if [ -z "$ROOT_UUID" ]; then
    echo "[grubcfg-fix] ERROR: could not read root UUID from /etc/fstab"
    exit 1
fi

echo "[grubcfg-fix] Writing /boot/grub/grub.cfg for UUID=${ROOT_UUID}"
mkdir -p /boot/grub

cat > /boot/grub/grub.cfg << GRUBEOF
set timeout_style=menu
set timeout=5
set default=0

insmod part_msdos
insmod ext2
insmod gzio

search --no-floppy --fs-uuid --set=root ${ROOT_UUID}

menuentry "Vertex Linux" {
    linux  /boot/vmlinuz-linux root=UUID=${ROOT_UUID} rw quiet loglevel=3
    initrd /boot/initramfs-linux.img
}

menuentry "Vertex Linux (fallback initramfs)" {
    linux  /boot/vmlinuz-linux root=UUID=${ROOT_UUID} rw quiet loglevel=3
    initrd /boot/initramfs-linux-fallback.img
}
GRUBEOF

echo "[grubcfg-fix] Done."
