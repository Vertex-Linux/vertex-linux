#!/usr/bin/env bash
# Vertex Linux — yay shim
# Passes through when called by vpkg or calamares; otherwise redirects to vpkg.

_called_by_calamares() {
    local pid=$PPID
    while [[ "$pid" -gt 1 ]]; do
        local comm
        comm=$(cat /proc/$pid/comm 2>/dev/null) || break
        [[ "$comm" == "calamares" ]] && return 0
        pid=$(awk '/^PPid:/{print $2}' /proc/$pid/status 2>/dev/null) || break
    done
    return 1
}

if [[ "${_VPKG_INTERNAL:-0}" == "1" ]] || _called_by_calamares; then
    exec /usr/bin/yay "$@"
fi

cat >&2 << 'EOF'

  ┌───────────────────────────────────────────────────┐
  │  Direct yay access is disabled on Vertex Linux.   │
  │                                                   │
  │  Use vpkg instead:                                │
  │    vpkg aur install  <package>                    │
  │    vpkg aur remove   <package>                    │
  │    vpkg aur search   <query>                      │
  │    vpkg aur update                                │
  │    vpkg aur list                                  │
  └───────────────────────────────────────────────────┘

EOF
exit 1
