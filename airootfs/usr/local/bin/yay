#!/usr/bin/env bash
# Vertex Linux — yay shim: warns users to use vpkg, but still runs.

if [[ "${_VPKG_INTERNAL:-0}" != "1" ]]; then
    cat >&2 << 'EOF'

  ┌───────────────────────────────────────────────────┐
  │  Tip: On Vertex Linux, use vpkg instead of yay.   │
  │    vpkg aur install  <package>                    │
  │    vpkg aur remove   <package>                    │
  │    vpkg aur update                                │
  └───────────────────────────────────────────────────┘

EOF
fi

exec /usr/bin/yay "$@"
