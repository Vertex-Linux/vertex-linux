#!/usr/bin/env bash
# Vertex Linux — pacman shim: warns users to use vpkg, but still runs.

if [[ "${_VPKG_INTERNAL:-0}" != "1" ]]; then
    cat >&2 << 'EOF'

  ┌─────────────────────────────────────────────────────┐
  │  Tip: On Vertex Linux, use vpkg instead of pacman.  │
  │    vpkg pm install  <package>                       │
  │    vpkg pm remove   <package>                       │
  │    vpkg pm update                                   │
  └─────────────────────────────────────────────────────┘

EOF
fi

exec /usr/bin/pacman "$@"
