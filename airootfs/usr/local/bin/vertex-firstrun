#!/usr/bin/env bash
# Runs once on first login. Sets up user directories, then removes itself.

# Create standard XDG user directories (Downloads, Documents, etc.)
command -v xdg-user-dirs-update &>/dev/null && xdg-user-dirs-update

# Remove this autostart entry so it never runs again
rm -f "${HOME}/.config/autostart/vertex-firstrun.desktop"
